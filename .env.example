# Local Compose initializes Azurite automatically with public emulator fixtures.
# Cloud credentials/configuration are generated privately by:
# python3 infra/deploy/prepare.py --help
# Host-run backend/worker cloud settings (managed identity, no account keys):
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_CONTAINER=mediamesh
ML_AZURE_STORAGE_ACCOUNT=yourstorageaccount
ML_AZURE_STORAGE_CONTAINER=mediamesh
