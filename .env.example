# Local Compose initializes Azurite automatically with public emulator fixtures.
# Cloud credentials/configuration are generated privately by:
# python3 infra/deploy/prepare.py --help
# Host-run backend/worker cloud settings (managed identity, no account keys):
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_CONTAINER=mediamesh
ML_AZURE_STORAGE_ACCOUNT=yourstorageaccount
ML_AZURE_STORAGE_CONTAINER=mediamesh

# Hosted captions and batch search verification (embeddings stay local).
ML_CAPTION_MODEL=google/gemma-4-26b-a4b-it
ML_OPENROUTER_API_KEY=
# Maximum provider prices, USD per million tokens.
ML_OPENROUTER_MAX_INPUT_PRICE=0.2
ML_OPENROUTER_MAX_OUTPUT_PRICE=0.75

# Google OAuth web client. Add this redirect URI in Google Cloud Console:
# http://localhost:8080/auth/realms/mediamesh/broker/google/endpoint
# Hosted: https://YOUR_DOMAIN/auth/realms/mediamesh/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
