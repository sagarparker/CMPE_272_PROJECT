# Deployment-only settings. Copy to .env.deploy and fill in every placeholder.
# Run ./deploy from main after pushing.
# Read by ./deploy; separate from the application's local .env.
AZURE_SUBSCRIPTION="Azure for Students"
AZURE_RESOURCE_GROUP=rg-mediamesh-script-demo
AZURE_LOCATION=swedencentral
AZURE_VM_NAME=vm-mediamesh-script-demo
AZURE_DNS_LABEL=replace-with-unique-lowercase-name
AZURE_STORAGE_ACCOUNT=replacewithuniquename
AZURE_STORAGE_CONTAINER=mediamesh
ADMIN_EMAIL=you@example.com
ACME_EMAIL=you@example.com
AZURE_SSH_CIDR=YOUR_PUBLIC_IPV4/32
AZURE_SSH_KEY=~/.ssh/mediamesh-demo
AZURE_SSH_USER=azureuser
AZURE_VM_SIZE=Standard_B2as_v2

# Hosted Google OAuth Web client and caption API credentials.
# Register https://YOUR_HOSTNAME/auth/realms/mediamesh/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ML_OPENROUTER_API_KEY=

# No auto-shutdown schedule. Stop compute manually: ./deploy vm-stop
