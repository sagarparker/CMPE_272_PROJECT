# Local defaults only. Never use these credentials for a deployment.
POSTGRES_USER=mediamesh
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=mediamesh
ML_DATABASE_URL=postgresql://mediamesh:local-development-only@postgres:5432/mediamesh
ML_API_PORT=8001
ML_MEDIA_ROOT=/data/media
ML_MODEL_CACHE=/data/models
ML_MODEL_NAME=sentence-transformers/clip-ViT-B-32
# Set ML_MODEL_REVISION after the step 2 evaluation.
ML_DEVICE=cpu
ML_LOG_LEVEL=INFO
ML_WORKER_POLL_SECONDS=2
ML_JOB_MAX_ATTEMPTS=3
ML_VIDEO_MAX_FRAMES=8
ML_VIDEO_TIMEOUT_SECONDS=120
