{
	email {$ACME_EMAIL}
}
{$APP_DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options SAMEORIGIN
	}
	# Allow only browser-facing OIDC paths. Management stays inside Docker.
	@identity path /auth/realms/* /auth/resources/* /auth/robots.txt
	handle @identity {
		reverse_proxy keycloak:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
	@private path /auth /auth/* /actuator /actuator/* /metrics /metrics/*
	handle @private {
		respond 404
	}
	handle {
		reverse_proxy frontend:80 {
			transport http {
				dial_timeout 3s
				response_header_timeout 95s
			}
		}
	}
}
